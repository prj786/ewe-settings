{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Settings",
  "version": "0.1.0",
  "identifier": "io.github.hyprshell.settings",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5174",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Settings",
        "width": 1020,
        "height": 700,
        "minWidth": 780,
        "minHeight": 520,
        "center": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage"],
    "category": "Settings",
    "shortDescription": "Settings for the hypr-shell desktop",
    "longDescription": "The settings application for the hypr-shell desktop: appearance, displays, input, power and startup. Writes the same configuration files the shell reads and asks it to reload.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png"]
  }
}
